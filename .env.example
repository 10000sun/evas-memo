# 이 파일을 .env로 복사해서 채운다. .env는 깃에 올라가지 않는다.

# 디스코드 개발자 포털(https://discord.com/developers/applications) > 애플리케이션 > OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# 사용자가 접속하는 주소(끝에 / 없이). 디스코드 Redirects에 "<이 주소>/auth/callback"을 등록해야 한다
PUBLIC_URL=https://memo.example.com
# 쿠키 서명용 비밀값. 반드시 채워 고정한다(비우면 재시작마다 바뀌어 모두 로그아웃되고 입력을 잃는다). 아무 긴 문자열(예: python -c "import secrets;print(secrets.token_hex(32))")
SESSION_SECRET=
# 첫 관리자 디스코드 ID(쉼표로 여러 명)
EVAS_ADMIN_IDS=
# (선택) 이 디스코드 서버 구성원만 볼 수 있게 제한. 서버 ID
DISCORD_GUILD_ID=

# (DuckDNS를 쓸 때만) 이름만 적는다. mymemo.duckdns.org 이면 mymemo
DUCKDNS_DOMAIN=
DUCKDNS_TOKEN=

# 폰·브라우저 푸시 알림(선택). python scripts/make_vapid.py 로 만든 값을 붙여 넣는다. 비우면 푸시만 꺼진다
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:본인메일@example.com

# 1이면 로그인한 사람 누구나 메모 작성·수정 가능(분류·권한 관리는 관리자만). 비우면 등록된 편집자만.
# 꼭 DISCORD_GUILD_ID도 함께 채울 것: 비우면 디스코드 계정이 있는 전 세계 누구나 편집할 수 있다
EVAS_OPEN_EDIT=1

# 주의: EVAS_DEV_AUTH는 개발·테스트 전용 로그인 우회다(로그인 없이 헤더로 신원을 정한다). 운영 .env에는 절대 넣지 않는다.

# 앱 포트(선택). 비우면 8001. 캘린더(8000)와 같은 PC에 올려도 겹치지 않는다
# EVAS_PORT=8001
# 캘린더와 같은 PC에서 Caddy 하나로 두 주소를 받을 때만(docs/DEPLOY.md): 캘린더 주소(끝에 / 없이)와 포트
# SHARED_CALENDAR_URL=https://cal.example.com
# SHARED_CALENDAR_PORT=8000

# 캘린더 연동(선택): 메모에서 @로 일정을 태그하고 캘린더에서 공동 메모를 태그한다. 설정 설명은 docs/DEPLOY.md "캘린더 연동 설정"
# LINK_API_KEY를 비우면 두 앱 사이 기능만 꺼진다(메모끼리의 @ 태그와 헤더 앱 전환 링크는 그대로)
# 두 앱 .env에 같은 값을 넣는다. 만들기: python -c "import secrets;print(secrets.token_urlsafe(32))"  (브라우저에는 나가지 않는다)
# 캘린더 앱 .env에는 MEMO_URL(이 앱의 PUBLIC_URL과 같은 주소), MEMO_INTERNAL_URL(기본 http://127.0.0.1:8001)을 넣는다
# LINK_API_KEY=
# 캘린더 공개 주소(끝에 / 없이). 없으면 SHARED_CALENDAR_URL을 쓴다. 헤더의 앱 전환 링크와 태그 주소에 쓰인다
# CALENDAR_URL=https://cal.example.com
# 이 서버가 캘린더를 부르는 내부 주소. 비우면 http://127.0.0.1:<SHARED_CALENDAR_PORT 또는 8000>
# CALENDAR_INTERNAL_URL=http://127.0.0.1:8000
